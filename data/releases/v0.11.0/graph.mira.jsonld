    {
      "@id": "https://doi.org/10.48550/arXiv.2112.04359",
      "@type": "SourceDocument",
      "title": "Ethical and social risks of harm from Language Models",
      "created": "2021-12-08",
      "creator": [
        "https://graph.aocommons.com/people/abeba-birhane",
        "https://graph.aocommons.com/people/atoosa-kasirzadeh",
        "https://graph.aocommons.com/people/borja-balle",
        "https://graph.aocommons.com/people/conor-griffin",
        "https://graph.aocommons.com/people/courtney-biles",
        "https://graph.aocommons.com/people/geoffrey-irving",
        "https://graph.aocommons.com/people/iason-gabriel",
        "https://graph.aocommons.com/people/john-w-mellor",
        "https://graph.aocommons.com/people/jonathan-uesato",
        "https://graph.aocommons.com/people/julia-haas",
